@using Clinic.Application.Features.Treatments.Queries.Result
@model SingleTreatmentDto

@{
    ViewData["Title"] = Model.Name;
    var articles   = Model.Articles;
    var totalPages = articles.PageSize > 0
        ? (int)Math.Ceiling((double)articles.TotalRows / articles.PageSize) : 0;
}

<section class="page-hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-7">
                <p class="text-uppercase text-primary fw-bold">Treatment</p>
                <h1>@Model.Name</h1>
                <p class="lead">@Model.Description</p>
                <a asp-controller="Consultations" asp-action="Create" class="btn btn-primary">
                    Book a consultation
                </a>
            </div>

            <div class="col-lg-5">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img class="img-fluid rounded-4" src="@Model.ImageUrl" alt="@Model.Name" />
                }
                else
                {
                    <div class="placeholder-image rounded-4"><i class="bi bi-stars"></i></div>
                }
            </div>

        </div>
    </div>
</section>

<section class="section">
    <div class="container">

        <div class="section-title">
            <h2>Related articles</h2>
            <p>Helpful information related to @Model.Name.</p>
        </div>

        <div class="row g-4">
            @foreach (var article in articles.Items)
            {
                <div class="col-lg-4 col-md-6">
                    <article class="article-card">
                        <div class="placeholder-image"><i class="bi bi-journal-medical"></i></div>
                        <div class="card-body">
                            <h3>@article.Title</h3>
                            <p>@article.Summary</p>
                            <a asp-controller="Articles" asp-action="Details"
                               asp-route-slug="@article.Slug" class="read-more">
                                Read article <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
            @if (!articles.Items.Any())
            {
                <div class="col-12">
                    <p class="text-center text-muted">No related articles are available yet.</p>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-5" aria-label="Related articles pagination">
                <ul class="pagination justify-content-center">
                    @if (articles.PageIndex > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Details"
                               asp-route-slug="@Model.Slug"
                               asp-route-pageIndex="@(articles.PageIndex - 1)"
                               asp-route-pageSize="@articles.PageSize">Previous</a>
                        </li>
                    }
                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == articles.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Details"
                               asp-route-slug="@Model.Slug"
                               asp-route-pageIndex="@pageNumber"
                               asp-route-pageSize="@articles.PageSize">@pageNumber</a>
                        </li>
                    }
                    @if (articles.PageIndex < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Details"
                               asp-route-slug="@Model.Slug"
                               asp-route-pageIndex="@(articles.PageIndex + 1)"
                               asp-route-pageSize="@articles.PageSize">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="mt-5">
            <a asp-action="Index" class="read-more">
                <i class="bi bi-arrow-left"></i> All treatments
            </a>
        </div>

    </div>
</section>
