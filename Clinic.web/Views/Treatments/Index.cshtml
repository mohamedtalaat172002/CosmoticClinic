@using Clinic.Application.Features.Treatments.Queries.Result
@model Clinic.Application.Abstractions.Queries.PagedResult<AllTreatmentsDto>

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.ServicesPageTitle].Value;
    var search = Context.Request.Query["search"].ToString();
    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRows / Model.PageSize) : 0;
}

<section class="page-hero">
    <div class="container text-center">
        <h1>@_localizer[SharedResourcesKeys.ServicesPageTitle]</h1>
        <p class="lead mb-0">@_localizer[SharedResourcesKeys.ServicesPageSub]</p>
    </div>
</section>

<section class="section">
    <div class="container">

        <form method="get" asp-action="Index" class="mb-5">
            <div class="input-group" style="max-width: 480px; margin: 0 auto;">
                <input type="text" name="search" value="@search" class="form-control"
                       placeholder="@_localizer[SharedResourcesKeys.SearchServicesPlaceholder]"
                       aria-label="Search services" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>

        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-lg-4 col-md-6">
                    <article class="service-card">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top card-media" />
                        }
                        else
                        {
                            <div class="placeholder-image"><i class="bi bi-stars"></i></div>
                        }
                        <div class="card-body">
                            <h3>@item.Name</h3>
                            <p>@item.Description</p>
                            <a asp-action="Details" asp-route-slug="@item.Slug" class="read-more">
                                @_localizer[SharedResourcesKeys.ExploreService] <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
            @if (!Model.Items.Any())
            {
                <div class="col-12">
                    <p class="text-center text-muted">
                        @(string.IsNullOrWhiteSpace(search)
                            ? _localizer[SharedResourcesKeys.NoServicesAvailable].Value
                            : string.Format(_localizer[SharedResourcesKeys.NoServicesFound].Value, search))
                    </p>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-5" aria-label="Services pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.PageIndex > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@search"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                @_localizer[SharedResourcesKeys.Previous]
                            </a>
                        </li>
                    }
                    @for (var pageNum = 1; pageNum <= totalPages; pageNum++)
                    {
                        <li class="page-item @(pageNum == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@search"
                               asp-route-pageIndex="@pageNum"
                               asp-route-pageSize="@Model.PageSize">@pageNum</a>
                        </li>
                    }
                    @if (Model.PageIndex < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@search"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                @_localizer[SharedResourcesKeys.Next]
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</section>
