@using Clinic.Application.Features.Articles.Queries.Result
@model Clinic.Application.Abstractions.Queries.PagedResult<AllArticlesDto>

@{
    ViewData["Title"] = "Articles";
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling(
            (double)Model.TotalRows / Model.PageSize)
        : 0;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1 fw-semibold">Articles</h4>

            <p class="text-muted mb-0">
                Manage the articles displayed on your website.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary d-flex align-items-center gap-2">

            <i class="ti ti-plus"></i>

            Add Article

        </a>

    </div>


    <form method="get"
          asp-action="Index"
          class="mb-4">

        <div class="input-group"
             style="max-width: 450px;">

            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="Search articles..." />

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <button class="btn btn-primary"
                    type="submit">

                <i class="ti ti-search"></i>

            </button>

        </div>

    </form>


    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">

            @(string.IsNullOrWhiteSpace(search)
                    ? "No articles are available."
                    : $"No articles found for \"{search}\".")

    </div>
        }
    else
    {
        <div class="row g-4">

            @foreach (var article in Model.Items)
            {
                <div class="col-xl-4 col-md-6">

                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(
                                        article.FeaturedImageUrl))
                        {
                            <img src="@article.FeaturedImageUrl"
                                 class="card-img-top"
                                 alt="@article.Title"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex
                                                    align-items-center
                                                    justify-content-center
                                                    bg-light"
                                 style="height: 200px;">

                                <i class="ti ti-news fs-1 text-muted"></i>

                            </div>
                        }


                        <div class="card-body">

                            <h5 class="card-title">
                                @article.Title
                            </h5>

                            <p class="card-text text-muted">
                                @article.Summary
                            </p>


                            <div class="d-flex gap-2 mt-3">

                                <a asp-action="Edit"
                                   asp-route-slug="@article.Slug"
                                   class="btn btn-sm btn-primary">

                                    <i class="ti ti-edit"></i>
                                    Edit

                                </a>


                                <form asp-action="Delete"
                                      asp-route-id="@article.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this article?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">

                                        <i class="ti ti-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">

                            Previous

                        </a>

                    </li>
                }


                @for (var pageNum = 1;
                            pageNum <= totalPages;
                            pageNum++)
                {
                    <li class="page-item
                                @(pageNum == Model.PageIndex
                                                    ? "active"
                                                    : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-search="@search"
                   asp-route-pageIndex="@pageNum"
                   asp-route-pageSize="@Model.PageSize">

                            @pageNum

                        </a>

                    </li>
                        }


                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">

                            Next

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>

