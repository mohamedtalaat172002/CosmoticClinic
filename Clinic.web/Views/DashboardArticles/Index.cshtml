@using Clinic.Application.Features.Articles.Queries.Result
@using Clinic.Domain.Entities.artical
@model Clinic.Application.Abstractions.Queries.PagedResult<AllArticlesDto>

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashArtPageTitle].Value;
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();
    var selectedStatus = Context.Request.Query["status"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRows / Model.PageSize)
        : 0;
}

<style>
    /* Short teaser: max 3 lines, ellipsis after that */
    .card-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container-fluid">

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold display-6 mb-2">@_localizer[SharedResourcesKeys.DashArtPageTitle]</h1>
        <p class="text-muted fs-5 mb-3">@_localizer[SharedResourcesKeys.DashArtPageSub]</p>

        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
            <i class="ti ti-plus"></i>
            @_localizer[SharedResourcesKeys.DashArtAddBtn]
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="hero-search mb-4">
        <form method="get" asp-action="Index">
            <div class="input-group">
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="@_localizer[SharedResourcesKeys.DashArtSearchPlaceholder]"
                       aria-label="Search articles" />

                <select name="status"
                        class="form-select"
                        style="max-width: 160px;"
                        aria-label="Filter by status">
                    <option value="">@_localizer[SharedResourcesKeys.DashArtAllStatuse]</option>

                    @foreach (var status in Enum.GetValues<ArticleStatus>())
                    {
                        <option value="@status" selected="@(selectedStatus == status.ToString())">
                            @status
                        </option>
                    }
                </select>

                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <button class="btn btn-primary px-4" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">
            @(string.IsNullOrWhiteSpace(search) && string.IsNullOrWhiteSpace(selectedStatus)
                    ? _localizer[SharedResourcesKeys.DashArtNoAvailable].Value
                    : _localizer[SharedResourcesKeys.DashArtNoFound].Value)
    </div>
        }
    else
    {
        <div class="row g-4">
            @foreach (var article in Model.Items)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100">

                        @* FeaturedImageUrl is a string (primary image URL) in AllArticlesDto *@
                        @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl.Url))
                        {
                            <img src="@article.FeaturedImageUrl.Url"
                                 class="card-img-top card-media"
                                 alt="@article.Title"
                                 @* style="height: 200px; object-fit: cover;"  *@
                                 
                                 />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 200px;">
                                <i class="ti ti-news fs-1 text-muted"></i>
                            </div>
                        }

                        @* Tight padding: text sits close to the card edges *@
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title mb-0">@article.Title</h5>
                                <span class="badge bg-light text-dark">@article.Status</span>
                            </div>

                            <p class="card-text text-muted small card-excerpt mb-2" dir="auto">@article.Summary</p>

                            <div class="d-flex gap-2">
                                @* Edit is by Id (the slug changes with the title) *@
                                <a asp-action="Edit"
                                   asp-route-id="@article.Id"
                                   class="btn btn-sm btn-primary">
                                    <i class="ti ti-edit"></i>
                                    @_localizer[SharedResourcesKeys.DashEdit]
                                </a>

                                @* The form tag helper already emits the antiforgery token *@
                                <form asp-action="Delete"
                                      asp-route-id="@article.Id"
                                      method="post"
                                      onsubmit="return confirm('@_localizer[SharedResourcesKeys.DashArtDeleteConfirm]');">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="ti ti-trash"></i>
                                        @_localizer[SharedResourcesKeys.DashDelete]
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Articles pagination">
            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            @_localizer[SharedResourcesKeys.Previous]
                        </a>
                    </li>
                }

                @for (var pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@pageNum"
                           asp-route-pageSize="@Model.PageSize">
                            @pageNum
                        </a>
                    </li>
                }

                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            @_localizer[SharedResourcesKeys.Next]
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>
