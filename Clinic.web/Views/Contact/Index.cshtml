@using Clinic.Application.Features.ClinicSetting.Queries.Result
@model ContactInputModel

@{
    ViewData["Title"] = "Contact us";
    var settings = ViewData["ClinicSettings"] as ClinicSettingDto;
    var email   = settings?.Email          ?? "hello@cosmeticclinic.com";
    var phone   = settings?.WhatsAppNumber ?? "+20 100 000 0000";
    var address = settings?.Address        ?? "Cairo, Egypt";
}

<section class="form-section">
    <div class="container">
        <div class="row g-5 align-items-start">

            <div class="col-lg-5">
                <p class="text-uppercase text-primary fw-bold">We would love to hear from you</p>
                <h1>Contact our clinic</h1>
                <p class="lead">Ask a question, share a concern, or request more information before your visit.</p>
                <div class="mt-4">
                    <p><i class="bi bi-geo-alt text-primary me-2"></i>@address</p>
                    <p><i class="bi bi-telephone text-primary me-2"></i>@phone</p>
                    <p><i class="bi bi-envelope text-primary me-2"></i>@email</p>
                </div>
            </div>

            <div class="col-lg-7">
                <form class="form-panel" asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <button class="btn btn-primary" type="submit">
                        Send message <i class="bi bi-send"></i>
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
