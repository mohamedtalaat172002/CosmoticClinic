@using Clinic.Application.Features.Treatments.Queries.Result
@model Clinic.Application.Abstractions.Queries.PagedResult<AllTreatmentsDto>

@{
    ViewData["Title"] = "Treatments";
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRows / Model.PageSize)
        : 0;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-semibold">Treatments</h4>
            <p class="text-muted mb-0">
                Manage the treatments displayed on your website.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary d-flex align-items-center gap-2">
            <i class="ti ti-plus"></i>
            Add Treatment
        </a>
    </div>


    <form method="get"
          asp-action="Index"
          class="mb-4">

        <div class="input-group" style="max-width: 450px;">

            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="Search treatments..." />

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <button class="btn btn-primary" type="submit">
                <i class="ti ti-search"></i>
            </button>

        </div>

    </form>


    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">
            @(string.IsNullOrWhiteSpace(search)
                    ? "No treatments are available."
                    : $"No treatments found for \"{search}\".")
    </div>
        }
    else
    {
        <div class="row g-4">

            @foreach (var treatment in Model.Items)
            {
                <div class="col-xl-4 col-md-6">

                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(treatment.ImageUrl))
                        {
                            <img src="@treatment.ImageUrl"
                                 class="card-img-top"
                                 alt="@treatment.Name"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 200px;">
                                <i class="ti ti-medical-cross fs-1 text-muted"></i>
                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @treatment.Name
                            </h5>

                            <p class="card-text text-muted">
                                @treatment.Description
                            </p>

                            <div class="d-flex gap-2 mt-3">

                                <a asp-action="Edit"
                                   asp-route-slug="@treatment.Slug"
                                   class="btn btn-sm btn-primary">
                                    <i class="ti ti-edit"></i>
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@treatment.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this treatment?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        <i class="ti ti-trash"></i>
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Previous
                        </a>
                    </li>
                }

                @for (var pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == Model.PageIndex ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@pageNum"
                           asp-route-pageSize="@Model.PageSize">
                            @pageNum
                        </a>

                    </li>
                }

                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>

