@using Clinic.Application.Features.Treatments.Queries.Result
@model Clinic.Application.Abstractions.Queries.PagedResult<AllTreatmentsDto>

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashTreatPageTitle].Value;
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRows / Model.PageSize)
        : 0;
}

<style>
    /* Short teaser: max 3 lines, ellipsis after that */
    .card-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container-fluid">

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold display-6 mb-2">@_localizer[SharedResourcesKeys.DashTreatPageTitle]</h1>
        <p class="text-muted fs-5 mb-3">@_localizer[SharedResourcesKeys.DashTreatPageSub]</p>

        <a asp-action="Create"
           class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
            <i class="ti ti-plus"></i>
            @_localizer[SharedResourcesKeys.DashTreatAddBtn]
        </a>
    </div>

    <!-- Search -->
    <form method="get" asp-action="Index" class="mb-4">
        <div class="input-group mx-auto" style="max-width: 450px;">
            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="@_localizer[SharedResourcesKeys.DashTreatSearchPlaceholder]" />

            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <button class="btn btn-primary px-4" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">
            @(string.IsNullOrWhiteSpace(search)
                    ? _localizer[SharedResourcesKeys.DashTreatNoAvailable].Value
                    : string.Format(_localizer[SharedResourcesKeys.DashTreatNoFound].Value, search))
    </div>
        }
    else
    {
        <div class="row g-4">
            @foreach (var treatment in Model.Items)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(treatment.ImageUrl))
                        {
                            <img src="@treatment.ImageUrl"
                                 class="card-img-top card-media"
                                 alt="@treatment.Name"
                                 @* style="height: 200px; object-fit: cover;" *@
                                 
                                 />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height: 200px;">
                                <i class="ti ti-medical-cross fs-1 text-muted"></i>
                            </div>
                        }

                        @* Tight padding: text sits close to the card edges *@
                        <div class="card-body p-2">

                            <h5 class="card-title mb-1">@treatment.Name</h5>

                            @* The handler already trims the description to a short excerpt *@
                            <p class="card-text text-muted small card-excerpt mb-2" dir="auto">@treatment.Description</p>

                            <div class="d-flex gap-2">
                                <a asp-action="Edit"
                                   asp-route-id="@treatment.Id"
                                   class="btn btn-sm btn-primary">
                                    <i class="ti ti-edit"></i>
                                    @_localizer[SharedResourcesKeys.DashEdit]
                                </a>

                                @* The form tag helper already emits the antiforgery token *@
                                <form asp-action="Delete"
                                      asp-route-id="@treatment.Id"
                                      method="post"
                                      onsubmit="return confirm('@_localizer[SharedResourcesKeys.DashTreatDeleteConfirm]');">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="ti ti-trash"></i>
                                        @_localizer[SharedResourcesKeys.DashDelete]
                                    </button>
                                </form>
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Treatments pagination">
            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            @_localizer[SharedResourcesKeys.Previous]
                        </a>
                    </li>
                }

                @for (var pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@pageNum"
                           asp-route-pageSize="@Model.PageSize">
                            @pageNum
                        </a>
                    </li>
                }

                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            @_localizer[SharedResourcesKeys.Next]
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>
