
@model HomeViewModel

@{
    ViewData["Title"] = "Confidence starts here";
    var settings = Model.ClinicSettings;
}

<section id="hero" class="hero section">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <div class="hero-content">

                    <div class="trust-badges mb-4">
                        <div class="badge-item">
                            <i class="bi bi-patch-check"></i>
                            <span>Personalized care</span>
                        </div>
                        <div class="badge-item">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Trusted specialists</span>
                        </div>
                    </div>

                    <h1>
                        Refined care for your
                        <span class="highlight">natural confidence</span>
                    </h1>

                    <p class="hero-description">
                        A calm, considered approach to aesthetic treatments — with your goals
                        and comfort at the center of every visit.
                    </p>

                    <div class="hero-actions">
                        <a asp-controller="Consultations"
                           asp-action="Create"
                           class="btn btn-primary">
                            Book a consultation <i class="bi bi-arrow-right"></i>
                        </a>

                        <a asp-controller="Treatments"
                           asp-action="Index"
                           class="btn btn-outline">
                            Explore treatments
                        </a>
                    </div>

                    <div class="hero-search mt-4">
                        <form id="heroSearchForm" method="get" action="/Treatments">
                            <div class="input-group">

                                <input type="text"
                                       name="search"
                                       class="form-control"
                                       placeholder="Search treatments or articles…"
                                       aria-label="Search" />

                                <select id="searchTarget"
                                        class="form-select"
                                        style="max-width: 140px;"
                                        aria-label="Search in">
                                    <option value="/Treatments">Treatments</option>
                                    <option value="/Articles">Articles</option>
                                </select>

                                <button class="btn btn-primary" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>

                            </div>
                        </form>

                        <script>
                            document.getElementById('searchTarget').addEventListener('change', function () {
                                document.getElementById('heroSearchForm').action = this.value;
                            });
                        </script>
                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image">
                    @if (!string.IsNullOrWhiteSpace(settings?.HeroImageUrl))
                    {
                        <img src="@settings.HeroImageUrl"
                             class="img-fluid"
                             alt="@(settings.DoctorName ?? "Clinic specialist")" />
                    }
                    else
                    {
                        <img src="~/assets/img/health/staff-8.webp"
                             class="img-fluid"
                             alt="Clinic specialist" />
                    }
                </div>
            </div>

        </div>
    </div>
</section>


<!-- Treatments -->
<section class="section">
    <div class="container">

        <div class="section-title" data-aos="fade-up">
            <h2>Our treatments</h2>
            <p>Choose care designed around you.</p>
        </div>

        <div class="row g-4">

            @foreach (var item in Model.Treatments)
            {
                <div class="col-md-4" data-aos="fade-up">
                    <article class="service-card">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.Name" />
                        }
                        else
                        {
                            <div class="placeholder-image">
                                <i class="bi bi-stars"></i>
                            </div>
                        }

                        <div class="card-body">
                            <h3>@item.Name</h3>

                            <p>@item.Description</p>

                            <a asp-controller="Treatments"
                               asp-action="Details"
                               asp-route-slug="@item.Slug"
                               class="read-more">
                                Learn more
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                    </article>
                </div>
            }

            @if (!Model.Treatments.Any())
            {
                <p class="text-center text-muted">
                    Treatments will appear here soon.
                </p>
            }

        </div>

        <div class="text-center mt-5">
            <a class="btn btn-outline-primary"
               asp-controller="Treatments"
               asp-action="Index">
                View all treatments
            </a>
        </div>

    </div>
</section>


<!-- Articles -->
<section class="section light-background">
    <div class="container">

        <div class="section-title" data-aos="fade-up">
            <h2>Clinic journal</h2>
            <p>Helpful guidance for your skin and self-care journey.</p>
        </div>

        <div class="row g-3">

            @foreach (var article in Model.Articles)
            {
                <div class="col-md-4 col-lg-4" data-aos="fade-up">

                    <article class="article-card">

                        @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                        {
                            <img src="@article.FeaturedImageUrl"
                                 alt="@article.Title"
                                 class="img-fluid" />
                        }
                        else
                        {
                            <div class="placeholder-image">
                                <i class="bi bi-journal-medical"></i>
                            </div>
                        }

                        <div class="card-body">

                            <h3>@article.Title</h3>

                            <p>@article.Summary</p>

                            <a asp-controller="Articles"
                               asp-action="Details"
                               asp-route-slug="@article.Slug"
                               class="read-more">
                                Read article
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>

                    </article>

                </div>
            }

            @if (!Model.Articles.Any())
            {
                <p class="text-center text-muted">
                    Articles will appear here soon.
                </p>
            }

        </div>

        <div class="text-center mt-4">
            <a class="btn btn-outline-primary"
               asp-controller="Articles"
               asp-action="Index">
                View all articles
            </a>
        </div>

    </div>
</section>
