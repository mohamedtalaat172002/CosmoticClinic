@using Clinic.web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> _localizer

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | Clinic Admin</title>

    <link rel="shortcut icon" type="image/png" href="~/admin/images/logos/favicon.png" />

    <!-- Shared Bootstrap -->
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />

    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="~/admin/css/styles.min.css" />

    <style>
        /* Remove the big empty space at the top of the content */
        .body-wrapper,
        .body-wrapper-inner {
            padding-top: 0 !important;
            margin-top: 0 !important;
        }

            .body-wrapper > .container-fluid,
            .body-wrapper-inner > .container-fluid,
            .body-wrapper .container-fluid {
                padding-top: 20px !important;
            }

        @@media (max-width: 1199.98px) {

            .left-sidebar {
                position: fixed !important;
                top: 0;
                left: 0 !important;
                right: auto !important;
                width: 270px;
                height: 100vh;
                background: #fff;
                z-index: 1050 !important;
                overflow-y: auto;
                transform: translateX(-100%);
                transition: transform .3s ease;
                box-shadow: 0 0 20px rgba(0,0,0,.15);
            }

            [dir="rtl"] .left-sidebar {
                left: auto !important;
                right: 0 !important;
                transform: translateX(100%);
            }

            #main-wrapper.show-sidebar .left-sidebar {
                transform: translateX(0) !important;
            }

            .left-sidebar a,
            .left-sidebar .sidebar-link {
                pointer-events: auto !important;
                position: relative;
                z-index: 1;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 270px;
                right: 0;
                background: rgba(0,0,0,.5);
                z-index: 1040 !important;
            }

            [dir="rtl"] .sidebar-overlay {
                left: 0;
                right: 270px;
            }

            #main-wrapper.show-sidebar .sidebar-overlay {
                display: block;
            }

            .left-sidebar .hide-menu {
                display: inline-block !important;
                opacity: 1 !important;
            }

            .dashboard-mobile-header {
                position: sticky;
                top: 0;
                z-index: 1030;
                background: #fff;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 16px;
                box-shadow: 0 1px 6px rgba(0,0,0,.08);
            }

            .dashboard-mobile-toggle {
                border: 0;
                background: transparent;
                font-size: 1.6rem;
                line-height: 1;
            }
        }
    </style>
</head>

<body>

    <div class="page-wrapper"
         id="main-wrapper"
         data-layout="vertical"
         data-navbarbg="skin6"
         data-sidebartype="full"
         data-sidebar-position="fixed">

        <!-- Sidebar Overlay -->
        <div class="sidebar-overlay js-close-sidebar"></div>

        <!-- Sidebar -->
        <aside class="left-sidebar">
            <div>

                <div class="brand-logo d-flex align-items-center justify-content-between">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="text-nowrap logo-img">

                        <span class="fs-4 fw-bold text-primary">
                            Cosmetic Clinic
                        </span>

                    </a>

                    <!-- Mobile Close Button -->
                    <div class="close-btn d-xl-none d-block cursor-pointer js-close-sidebar"
                         id="sidebarCollapse">

                        <i class="ti ti-x fs-8"></i>

                    </div>

                </div>

                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">

                        <!-- View Site -->
                        <li class="sidebar-item">

                            <a class="sidebar-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <iconify-icon icon="solar:home-angle-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashViewSite]
                                </span>

                            </a>

                        </li>

                        <li>
                            <span class="sidebar-divider lg"></span>
                        </li>

                        <!-- Main -->
                        <li class="nav-small-cap">

                            <iconify-icon icon="solar:menu-dots-linear"
                                          class="nav-small-cap-icon fs-4">
                            </iconify-icon>

                            <span class="hide-menu">
                                @_localizer[SharedResourcesKeys.DashMain]
                            </span>

                        </li>

                        <!-- Overview -->
                        <li class="sidebar-item">

                            <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                <iconify-icon icon="solar:atom-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashOverview]
                                </span>

                            </a>

                        </li>

                        <!-- Clinic Settings -->
                        <li class="sidebar-item">

                            <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Settings">

                                <iconify-icon icon="solar:settings-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashClinicSettings]
                                </span>

                            </a>

                        </li>

                        <li>
                            <span class="sidebar-divider lg"></span>
                        </li>

                        <!-- Site -->
                        <li class="nav-small-cap">

                            <iconify-icon icon="solar:menu-dots-linear"
                                          class="nav-small-cap-icon fs-4">
                            </iconify-icon>

                            <span class="hide-menu">
                                @_localizer[SharedResourcesKeys.DashSite]
                            </span>

                        </li>

                        <!-- Treatments -->
                        <li class="sidebar-item">

                            <a class="sidebar-link"
                               asp-controller="DashboardTreatments"
                               asp-action="Index">

                                <iconify-icon icon="solar:medical-kit-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashTreatments]
                                </span>

                            </a>

                        </li>

                        <!-- Articles -->
                        <li class="sidebar-item">

                            <a class="sidebar-link"
                               asp-controller="DashboardArticles"
                               asp-action="Index">

                                <iconify-icon icon="solar:document-text-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashArticles]
                                </span>

                            </a>

                        </li>

                        <!-- Consultations -->
                        <li class="sidebar-item">

                            <a class="sidebar-link"
                               asp-controller="DashboardConsultations"
                               asp-action="Index">

                                <iconify-icon icon="solar:chat-round-line-duotone"></iconify-icon>

                                <span class="hide-menu">
                                    @_localizer[SharedResourcesKeys.DashConsultations]
                                </span>

                            </a>

                        </li>

                    </ul>
                </nav>

            </div>
        </aside>

        <!-- Mobile Header -->
        <div class="dashboard-mobile-header d-xl-none">

            <button type="button"
                    class="dashboard-mobile-toggle js-open-sidebar"
                    id="mobileSidebarToggle">

                <i class="bi bi-list"></i>

            </button>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="text-decoration-none">

                <span class="fw-bold text-primary">
                    Cosmetic Clinic
                </span>

            </a>

        </div>

        <!-- Dashboard Content -->
        <div class="body-wrapper">

            <div class="body-wrapper-inner">

                <div class="container-fluid">
                    @RenderBody()
                </div>

            </div>

        </div>

    </div>

    <!-- Shared Bootstrap JS -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Dashboard JS -->
    <script src="~/admin/js/sidebarmenu.js"></script>
    <script src="~/admin/js/app.min.js"></script>
    <script src="~/admin/libs/simplebar/dist/simplebar.js"></script>

    <!-- Iconify -->
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    <!-- Sidebar behavior -->
    <script>
        (function () {
            var wrapper = document.getElementById("main-wrapper");

            document.querySelectorAll(".js-open-sidebar").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    wrapper.classList.add("show-sidebar");
                });
            });

            document.querySelectorAll(".js-close-sidebar").forEach(function (el) {
                el.addEventListener("click", function () {
                    wrapper.classList.remove("show-sidebar");
                });
            });

            // Force sidebar links to navigate (template scripts may block them)
            document.addEventListener("click", function (e) {
                var a = e.target.closest ? e.target.closest("#sidebarnav a[href]") : null;
                if (!a) return;

                var href = a.getAttribute("href");
                if (!href || href === "#" || href.indexOf("javascript:") === 0) return;

                e.preventDefault();
                e.stopPropagation();
                wrapper.classList.remove("show-sidebar");
                window.location.href = a.href;
            }, true);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
