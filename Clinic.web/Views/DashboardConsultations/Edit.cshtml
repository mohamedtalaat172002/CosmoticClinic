@model Clinic.Application.Features.Consultations.Commands.Models.UpdateConsultationCommand

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashConEditTitle].Value;
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="mb-4">
        <h4 class="mb-1 fw-semibold">@_localizer[SharedResourcesKeys.DashConEditTitle]</h4>
        <p class="text-muted mb-0">@_localizer[SharedResourcesKeys.DashConEditSub]</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">@_localizer[SharedResourcesKeys.DashConLabelFullName]</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">@_localizer[SharedResourcesKeys.DashConLabelPhoneNumber]</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label">@_localizer[SharedResourcesKeys.DashConLabelMessage]</label>
                    <textarea asp-for="Message" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label">@_localizer[SharedResourcesKeys.DashConLabelStatus]</label>
                    <select asp-for="Status" class="form-select"
                            asp-items="Html.GetEnumSelectList<Clinic.Domain.Entities.consultation.ConsultationStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy"></i>
                        @_localizer[SharedResourcesKeys.DashSaveChanges]
                    </button>
                    <a asp-action="Index" class="btn btn-light">@_localizer[SharedResourcesKeys.DashCancel]</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
