@using Clinic.Application.Features.Consultations.Queries.Result
@using Clinic.Domain.Entities.consultation
@model Clinic.Application.Abstractions.Queries.PagedResult<AllConsultationsDto>

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashConPageTitle].Value;
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();
    var selectedStatus = Context.Request.Query["status"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRows / Model.PageSize)
        : 0;
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="text-center mb-4">

        <h1 class="fw-bold display-6 mb-2">
            @_localizer[SharedResourcesKeys.DashConPageTitle]
        </h1>

        <p class="text-muted fs-5 mb-3">
            @_localizer[SharedResourcesKeys.DashConPageSub]
        </p>

    </div>

    <!-- Search & Filter -->
    <div class="hero-search mb-4">

        <form method="get" asp-action="Index">

            <div class="input-group">

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="@_localizer[SharedResourcesKeys.DashConSearchPlaceholder]"
                       aria-label="Search consultations" />

                <select name="status"
                        class="form-select"
                        style="max-width: 160px;"
                        aria-label="Filter by status">

                    <option value="">
                        @_localizer[SharedResourcesKeys.DashConAllStatuses]
                    </option>

                    @foreach (var status in Enum.GetValues<ConsultationStatus>())
                    {
                        <option value="@status"
                                selected="@(selectedStatus == status.ToString())">
                            @status
                        </option>
                    }

                </select>

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />

                <button class="btn btn-primary"
                        type="submit">

                    <i class="bi bi-search"></i>

                </button>

            </div>

        </form>

    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">

            @(string.IsNullOrWhiteSpace(search) &&
                    string.IsNullOrWhiteSpace(selectedStatus)

                    ? _localizer[SharedResourcesKeys.DashConNoAvailable].Value

                    : _localizer[SharedResourcesKeys.DashConNoFound].Value)

    </div>
        }
    else
    {
        <div class="row g-4">

            @foreach (var consultation in Model.Items)
            {
                <div class="col-xl-4 col-md-6">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h5 class="card-title mb-0">
                                    @consultation.FullName
                                </h5>

                                <span class="badge bg-light text-dark">
                                    @consultation.Status
                                </span>

                            </div>

                            <div class="mb-2">

                                <small class="text-muted">
                                    @_localizer[SharedResourcesKeys.DashConLabelPhone]
                                </small>

                                <div>
                                    @consultation.PhoneNumber
                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(consultation.Message))
                            {
                                <div class="mb-3">

                                    <small class="text-muted">
                                        @_localizer[SharedResourcesKeys.DashConLabelMessage]
                                    </small>

                                    <p class="mb-0">
                                        @consultation.Message
                                    </p>

                                </div>
                            }

                            <div class="d-flex gap-2 mt-3">

                                <a asp-action="Edit"
                                   asp-route-id="@consultation.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="ti ti-edit"></i>

                                    @_localizer[SharedResourcesKeys.DashEdit]

                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@consultation.Id"
                                      method="post"
                                      onsubmit="return confirm('@_localizer[SharedResourcesKeys.DashConDeleteConfirm]');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">

                                        <i class="ti ti-trash"></i>

                                        @_localizer[SharedResourcesKeys.DashDelete]

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4"
             aria-label="Consultations pagination">

            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">

                            @_localizer[SharedResourcesKeys.Previous]

                        </a>

                    </li>
                }

                @for (var pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == Model.PageIndex ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@pageNum"
                           asp-route-pageSize="@Model.PageSize">

                            @pageNum

                        </a>

                    </li>
                }

                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">

                            @_localizer[SharedResourcesKeys.Next]

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>

