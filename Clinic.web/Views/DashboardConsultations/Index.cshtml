@using Clinic.Application.Features.Consultations.Queries.Result
@using Clinic.Domain.Entities.consultation

@model Clinic.Application.Abstractions.Queries.PagedResult<AllConsultationsDto>

@{
    ViewData["Title"] = "Consultations";
    Layout = "_DashboardLayout";

    var search = Context.Request.Query["search"].ToString();
    var selectedStatus = Context.Request.Query["status"].ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling(
            (double)Model.TotalRows / Model.PageSize)
        : 0;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1 fw-semibold">
                Consultations
            </h4>

            <p class="text-muted mb-0">
                Manage consultation requests from your website.
            </p>
        </div>

    </div>


    <!-- Search + Status Filter -->

    <div class="hero-search mb-4"> <form method="get" asp-action="Index"> <div class="input-group"> <input type="text" name="search" value="@search" class="form-control" placeholder="Search consultations…" aria-label="Search consultations" /> <select name="status" class="form-select" style="max-width: 160px;" aria-label="Filter by status"> <option value=""> All Statuses </option> @foreach (var status in Enum.GetValues<ConsultationStatus>()) {
    <option value="@status" selected="@(selectedStatus == status.ToString())"> @status </option>
        }
                </select> <input type="hidden" name="pageSize" value="@Model.PageSize" /> <button class="btn btn-primary" type="submit"> <i  color ="white" class="bi bi-search"></i> </button>
            </div>
        </form>
    </div>


    <!-- Consultations -->
    @if (!Model.Items.Any())
    {
        <div class="alert alert-light border">

            @(string.IsNullOrWhiteSpace(search) &&
                    string.IsNullOrWhiteSpace(selectedStatus)

                    ? "No consultations are available."

                    : "No consultations found with the selected filters.")

    </div>
        }
    else
    {
        <div class="row g-4">

            @foreach (var consultation in Model.Items)
            {
                <div class="col-xl-4 col-md-6">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex
                                                justify-content-between
                                                align-items-start
                                                mb-3">

                                <h5 class="card-title mb-0">
                                    @consultation.FullName
                                </h5>

                                <span class="badge bg-light text-dark">
                                    @consultation.Status
                                </span>

                            </div>


                            <div class="mb-2">

                                <small class="text-muted">
                                    Phone
                                </small>

                                <div>
                                    @consultation.PhoneNumber
                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                                consultation.Message))
                            {
                                <div class="mb-3">

                                    <small class="text-muted">
                                        Message
                                    </small>

                                    <p class="mb-0">
                                        @consultation.Message
                                    </p>

                                </div>
                            }


                            <div class="d-flex gap-2 mt-3">

                                <a asp-action="Edit"
                                   asp-route-id="@consultation.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="ti ti-edit"></i>
                                    Edit

                                </a>


                                <form asp-action="Delete"
                                      asp-route-id="@consultation.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this consultation?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">

                                        <i class="ti ti-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4"
             aria-label="Consultations pagination">

            <ul class="pagination justify-content-center">

                @if (Model.PageIndex > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           asp-route-pageSize="@Model.PageSize">

                            Previous

                        </a>

                    </li>
                }


                @for (var pageNum = 1;
                            pageNum <= totalPages;
                            pageNum++)
                {
                    <li class="page-item
                                @(pageNum == Model.PageIndex
                                                    ? "active"
                                                    : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-search="@search"
                   asp-route-status="@selectedStatus"
                   asp-route-pageIndex="@pageNum"
                   asp-route-pageSize="@Model.PageSize">

                            @pageNum

                        </a>

                    </li>
                        }


                @if (Model.PageIndex < totalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@selectedStatus"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           asp-route-pageSize="@Model.PageSize">

                            Next

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>

