@* @using Clinic.Application.Features.ClinicSetting.Queries.Result
@model ClinicSettingDto

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashPageTitle].Value;
    Layout = "_DashboardLayout";
}

<div class="container-fluid overflow-hidden">

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold display-6 mb-2">
            @_localizer[SharedResourcesKeys.DashPageTitle]
        </h1>

        <p class="text-muted fs-5 mb-3">
            @_localizer[SharedResourcesKeys.DashWelcome], @User.Identity?.Name
        </p>

        <a asp-action="Settings"
           class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
            <iconify-icon icon="solar:pen-line-duotone"></iconify-icon>
            @_localizer[SharedResourcesKeys.DashEditSettings]
        </a>
    </div>

    @if (Model is null)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3" role="alert">
            <iconify-icon icon="solar:danger-circle-line-duotone" class="fs-6"></iconify-icon>

            <div>
                @_localizer[SharedResourcesKeys.DashNotConfigured]

                <a asp-action="Settings" class="alert-link ms-1">
                    @_localizer[SharedResourcesKeys.DashConfigureNow]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">

            <!-- Clinic -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-none border h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-pill bg-primary-subtle px-3 py-2 d-inline-flex align-items-center justify-content-center">
                                <iconify-icon icon="solar:building-line-duotone"
                                              class="fs-7 text-primary">
                                </iconify-icon>
                            </div>

                            <span class="fs-3 text-muted fw-medium">
                                @_localizer[SharedResourcesKeys.DashCardClinic]
                            </span>
                        </div>

                        <h5 class="fw-semibold mb-1">
                            @(Model.ClinicName ?? "—")
                        </h5>

                        <p class="text-muted mb-0 fs-3">
                            @(Model.Specialization ?? _localizer[SharedResourcesKeys.DashNoSpecialization].Value)
                        </p>

                    </div>
                </div>
            </div>

            <!-- Doctor -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-none border h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-pill bg-success-subtle px-3 py-2 d-inline-flex align-items-center justify-content-center">
                                <iconify-icon icon="solar:user-rounded-line-duotone"
                                              class="fs-7 text-success">
                                </iconify-icon>
                            </div>

                            <span class="fs-3 text-muted fw-medium">
                                @_localizer[SharedResourcesKeys.DashCardDoctor]
                            </span>
                        </div>

                        <h5 class="fw-semibold mb-1">
                            @Model.DoctorName
                        </h5>

                        <p class="text-muted mb-0 fs-3">
                            @(Model.Address ?? "—")
                        </p>

                    </div>
                </div>
            </div>

            <!-- Contact -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-none border h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-pill bg-warning-subtle px-3 py-2 d-inline-flex align-items-center justify-content-center">
                                <iconify-icon icon="solar:phone-line-duotone"
                                              class="fs-7 text-warning">
                                </iconify-icon>
                            </div>

                            <span class="fs-3 text-muted fw-medium">
                                @_localizer[SharedResourcesKeys.DashCardContact]
                            </span>
                        </div>

                        <h5 class="fw-semibold mb-1">
                            @(Model.WhatsAppNumber ?? "—")
                        </h5>

                        <p class="text-muted mb-0 fs-3">
                            @(Model.Email ?? _localizer[SharedResourcesKeys.DashNoEmail].Value)
                        </p>

                    </div>
                </div>
            </div>

            <!-- Social -->
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-none border h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-pill bg-secondary-subtle px-3 py-2 d-inline-flex align-items-center justify-content-center">
                                <iconify-icon icon="solar:share-circle-line-duotone"
                                              class="fs-7 text-secondary">
                                </iconify-icon>
                            </div>

                            <span class="fs-3 text-muted fw-medium">
                                @_localizer[SharedResourcesKeys.DashCardSocial]
                            </span>
                        </div>

                        <div class="d-flex gap-3 mt-2 flex-wrap">

                            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                            {
                                <a href="@Model.FacebookUrl"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-sm btn-light d-flex align-items-center gap-1">
                                    <iconify-icon icon="ri:facebook-line"></iconify-icon>
                                    Facebook
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                            {
                                <a href="@Model.InstagramUrl"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-sm btn-light d-flex align-items-center gap-1">
                                    <iconify-icon icon="ri:instagram-line"></iconify-icon>
                                    Instagram
                                </a>
                            }

                            @if (string.IsNullOrWhiteSpace(Model.FacebookUrl) &&
                                                    string.IsNullOrWhiteSpace(Model.InstagramUrl))
                            {
                                <span class="text-muted fs-3">
                                    @_localizer[SharedResourcesKeys.DashNoSocialLinks]
                                </span>
                            }

                        </div>

                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4">

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="col-lg-6">
                    <div class="card shadow-none border h-100">
                        <div class="card-body">

                            <h5 class="card-title fw-semibold mb-3">
                                <iconify-icon icon="solar:file-text-line-duotone"
                                              class="me-2 text-primary">
                                </iconify-icon>

                                @_localizer[SharedResourcesKeys.DashCardDescription]
                            </h5>

                            <p class="mb-0 text-muted">
                                @Model.Description
                            </p>

                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
            {
                <div class="col-lg-6">
                    <div class="card shadow-none border h-100">
                        <div class="card-body">

                            <h5 class="card-title fw-semibold mb-3">
                                <iconify-icon icon="solar:gallery-line-duotone"
                                              class="me-2 text-primary">
                                </iconify-icon>

                                @_localizer[SharedResourcesKeys.DashCardHeroImage]
                            </h5>

                            <img src="@Model.HeroImageUrl"
                                 alt="Hero image"
                                 class="img-fluid rounded"
                                 style="max-height:220px;object-fit:cover;width:100%;" />

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div> *@
