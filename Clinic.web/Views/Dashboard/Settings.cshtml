
@model Clinic.web.Models.ClinicSettingsInputModel

@{
    ViewData["Title"] = _localizer[SharedResourcesKeys.DashSettingsTitle].Value;
    Layout = "_DashboardLayout";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h4 class="mb-1 fw-semibold">
            @_localizer[SharedResourcesKeys.DashSettingsTitle]
        </h4>
        <p class="mb-0 text-muted">
            @_localizer[SharedResourcesKeys.DashSettingsSub]
        </p>
    </div>

    <div class="col-auto">
        <a asp-action="Index"
           class="btn btn-light d-flex align-items-center gap-2">
            <iconify-icon icon="solar:arrow-left-line-duotone"></iconify-icon>
            @_localizer[SharedResourcesKeys.DashBackOverview]
        </a>
    </div>
</div>

<form asp-action="Settings"
      method="post"
      enctype="multipart/form-data"
      novalidate>

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger mb-4"
         role="alert"></div>

    <div class="row g-4">

        <!-- Clinic Information -->
        <div class="col-lg-6">
            <div class="card shadow-none border h-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">
                        @_localizer[SharedResourcesKeys.DashSectionClinicInfo]
                    </h5>

                    <div class="mb-3">
                        <label asp-for="ClinicName" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelClinicName]
                        </label>
                        <input asp-for="ClinicName" class="form-control" />
                        <span asp-validation-for="ClinicName"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorName" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelDoctorName]
                        </label>
                        <input asp-for="DoctorName" class="form-control" />
                        <span asp-validation-for="DoctorName"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Specialization" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelSpecialization]
                        </label>
                        <input asp-for="Specialization" class="form-control" />
                        <span asp-validation-for="Specialization"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelDescription]
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="col-lg-6">
            <div class="card shadow-none border h-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">
                        @_localizer[SharedResourcesKeys.DashSectionContact]
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelEmail]
                        </label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WhatsAppNumber" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelWhatsApp]
                        </label>
                        <input asp-for="WhatsAppNumber" class="form-control" />
                        <span asp-validation-for="WhatsAppNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-medium">
                            @_localizer[SharedResourcesKeys.DashLabelAddress]
                        </label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address"
                              class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Images and Social Media -->
        <div class="col-12">
            <div class="card shadow-none border">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">
                        @_localizer[SharedResourcesKeys.DashSectionSocialMedia]
                    </h5>

                    <!-- Existing Images -->
                    @if (Model.ExistingImages.Count > 0)
                    {
                        <div class="mb-4" id="existing-images">
                            <label class="form-label fw-medium">Current images</label>

                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var image in Model.ExistingImages)
                                {
                                    <div class="position-relative">
                                        <img src="@image.Url"
                                             alt="Clinic image"
                                             class="rounded border"
                                             style="width: 120px; height: 90px; object-fit: cover;" />

                                        @if (image.IsPrimary)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-1">
                                                Primary
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Images" class="form-label fw-medium">
                                @_localizer[SharedResourcesKeys.DashLabelHeroImageUrl]
                            </label>

                            <input asp-for="Images"
                                   class="form-control"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp"
                                   multiple />

                            <div class="form-text">
                                Leave empty to keep current images. Uploading new images replaces the current gallery.
                            </div>

                            <div id="new-image-preview"
                                 class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FacebookUrl" class="form-label fw-medium">
                                @_localizer[SharedResourcesKeys.DashLabelFacebookUrl]
                            </label>
                            <input asp-for="FacebookUrl" class="form-control" />
                            <span asp-validation-for="FacebookUrl"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InstagramUrl" class="form-label fw-medium">
                                @_localizer[SharedResourcesKeys.DashLabelInstagramUrl]
                            </label>
                            <input asp-for="InstagramUrl" class="form-control" />
                            <span asp-validation-for="InstagramUrl"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex gap-3 mt-4">
        <button type="submit"
                class="btn btn-primary d-flex align-items-center gap-2">
            <iconify-icon icon="solar:floppy-disk-line-duotone"></iconify-icon>
            @_localizer[SharedResourcesKeys.DashSaveChanges]
        </button>

        <a asp-action="Index" class="btn btn-light">
            @_localizer[SharedResourcesKeys.DashCancel]
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ImageUploadPreview" />
}
